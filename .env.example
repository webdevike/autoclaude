# LLM Providers (OpenRouter is default, OpenAI is fallback)
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Telegram
# Shared token (used if no per-mode token is set)
TELEGRAM_BOT_TOKEN=
# Per-mode tokens (optional — set these to use separate bots per mode)
TELEGRAM_BOT_TOKEN_PERSONAL=
TELEGRAM_BOT_TOKEN_WORK=

# Slack
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=

# Notion
NOTION_API_KEY=

# Linear
LINEAR_API_KEY=

# Gmail (OAuth2)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# General
JARVIS_MODE=personal
JARVIS_CONFIG_DIR=./config
