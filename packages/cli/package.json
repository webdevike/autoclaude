{
  "name": "@jarvis/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "jarvis": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "NODE_OPTIONS='--conditions development' tsx watch src/index.ts",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@jarvis/core": "workspace:*",
    "@jarvis/gateway": "workspace:*",
    "@jarvis/channel-telegram": "workspace:*",
    "@jarvis/integration-linear": "workspace:*",
    "@jarvis/integration-gmail": "workspace:*",
    "@jarvis/scheduler": "workspace:*",
    "@jarvis/status-reporter": "workspace:*",
    "dotenv": "^16.4.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.4.0"
  }
}
