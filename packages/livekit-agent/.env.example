# LiveKit Cloud credentials (get from https://cloud.livekit.io)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret

# OpenAI (for Realtime voice)
OPENAI_API_KEY=sk-...

# Jarvis integrations (same keys as your main .env)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
NOTION_API_KEY=
LINEAR_API_KEY=
EXA_API_KEY=
