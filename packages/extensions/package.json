{
  "name": "@jarvis/extensions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    "./gmail/*": {
      "development": "./gmail/*",
      "default": "./dist/gmail/*"
    },
    "./exa/*": {
      "development": "./exa/*",
      "default": "./dist/exa/*"
    },
    "./linear/*": {
      "development": "./linear/*",
      "default": "./dist/linear/*"
    },
    "./notion/*": {
      "development": "./notion/*",
      "default": "./dist/notion/*"
    }
  },
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@linear/sdk": "^33.0.0",
    "@mariozechner/pi-coding-agent": "^0.52.3",
    "@notionhq/client": "^2.2.15",
    "@sinclair/typebox": "^0.34.48",
    "@tryfabric/martian": "^1.2.4",
    "exa-js": "^1.0.0",
    "googleapis": "^140.0.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
